{% assign cfv = trmnl.plugin_settings.custom_fields_values %}
{% assign chart_id = "chart-" | append_random %}

<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts-more.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>

<div class="layout layout--col">
{% if error %}
  <h1>{{ status_code }}</h1>
  <h2>{{ status_msg }}</h2>
{% else %}
  <div id="{{ chart_id }}" class="w--full h--full"></div>
{% endif %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance" id="year-range">{{ cfv.start_year }}-{{ 'now' | date: '%Y' }}</span>
</div>

<script type="text/javascript"> 
    
  // Toggle switch for units: false = °C, true = °F
  const useFahrenheit = "{{ cfv.degree_unit }}" == "fahrenheit"; 
  const startYear = {{ cfv.start_year }};
  const lineCount = {{ cfv.line_count }}; 

  // Raw anomaly data in °C
  const convert = (data) => useFahrenheit
    ? data.map(val => (val === null ? null : +(val * 1.8).toFixed(2)))
    : data;   
    
  let yAxisMin = useFahrenheit ? -3 : -2;
  const yAxisMax = useFahrenheit ? 2.8 : 1.8;
  const unitSymbol  = useFahrenheit ? '°F' : '°C';
  
  // Detect vertical constraints (Portrait screen OR half_vertical view layout)
  const isPortrait = document.querySelector('.screen--portrait') !== null;
  const isFull = document.querySelector('.view--full') !== null;
  const isHalfVertical = document.querySelector('.view--half_vertical') !== null;
  const isHalfHorizontal = document.querySelector('.view--half_horizontal') !== null;
  const isQuadrant = document.querySelector('.view--quadrant') !== null;
  const domYearRange = document.getElementById('year-range');

  console.log(`isPortrait: ${isPortrait}, isFull: ${isFull}, isHalfVertical: ${isHalfVertical}, isHalfHorizontal: ${isHalfHorizontal}, isQuadrant: ${isQuadrant}`);

  // default values for full and lanscape layout
  let lineWidth = 4;
  let lineWidthCurr = 8;
  let isPolar = true;
  let legendLayout = "vertical";
  let legendAlign = "right";
  let legendVerticalAlign = "middle";
  let xAxisOffset = 10;
  let chartInverted = false;
  let chartMarginBottom = 0;
  let showYAxisMin = false;

  if (isFull) {
    if (isPortrait) {
      legendLayout = "horizontal";
      legendVerticalAlign = "bottom";
    }
  } else if (isHalfHorizontal) {
    lineWidth = 3;
    lineWidthCurr = 6;
    if (isPortrait) {

    } else {
      isPolar = false;
      legendLayout = "horizontal";
      legendVerticalAlign = "bottom";
      yAxisMin += 1;
      xAxisOffset = -10;
      showYAxisMin = true;
      chartMarginBottom = 45;
    }
  } else if (isHalfVertical) {
    lineWidth = 2;
    lineWidthCurr = 4;
    legendLayout = "horizontal";
    legendVerticalAlign = "bottom";
    if (isPortrait) {
      domYearRange.hidden = true;
      chartInverted = true;
      isPolar = false;
      yAxisMin += 1;
      showYAxisMin = true;
      chartMarginBottom = undefined;
    } else {
      chartMarginBottom = 15;
    }
  } else if (isQuadrant) {
    lineWidth = 2;
    lineWidthCurr = 4;
    xAxisOffset = 15;
    if (isPortrait) {
      domYearRange.hidden = true;
      legendLayout = "horizontal";
      legendAlign = "center";
      legendVerticalAlign = "bottom";
      chartMarginBottom = 100;
    } else {
      legendAlign = "right";
      legendLayout = "horizontal";
    }
  }




  const climateData = {{ history | json }};

  // Filter data from startYear up to now 
  let availableData = climateData.filter(item => Number(item.name) >= startYear);
  // Fallback: keep current year if startYear exceeds dataset
  if (availableData.length === 0 && climateData.length > 0) {
    availableData = [climateData[climateData.length - 1]];
  }

  const totalAvailable = availableData.length;

  // Evenly select lineCount entries including first and last
  const activeSeries = [];
  if (totalAvailable <= lineCount) {
    activeSeries.push(...availableData);
  } else {
    for (let i = 0; i < lineCount; i++) {
      const index = Math.round((i / (lineCount - 1)) * (totalAvailable - 1));
      activeSeries.push(availableData[index]);
    }
  }

  const totalSeries = activeSeries.length;


  Highcharts.chart('{{ chart_id }}', {
    chart: {
      polar: isPolar,
      type: 'spline',
      inverted: chartInverted,
      height: null,
      width: null,
      animation: false,
      spacing: [0, 0, 0, 0],
      marginBottom: chartMarginBottom,
    },
    title: { text: null },
    pane: {
      startAngle: 0,
      endAngle: 360,
    },
    plotOptions: {
      series: {
        animation: false,
        enableMouseTracking: false,
        states: {
          hover: { enabled: false }
        },
        marker: {
          enabled: false
        },
        connectNulls: false
      }
    },
    xAxis: {
      categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
      tickmarkPlacement: 'on',
      lineWidth: 0,
      gridLineWidth: 0,
      offset: xAxisOffset,
      labels: {
        style: { fontSize: '14px', color: '#000000', }
      }
    },
    yAxis: {
      min: yAxisMin,
      max: yAxisMax,           // Set max slightly below top tick to stop Highcharts drawing outermost grid ring
      tickInterval: 1,         // Force tick every 1 degree
      endOnTick: false,        // Don't force gridline at top boundary
      showLastLabel: true,
      gridLineDashStyle: 'shortdot',
      gridLineWidth: 1,
      gridLineColor: '#000000',
      labels: {
        style: { 
          fontSize: '14px', 
          color: '#000000',
          textOutline: '2px #ffffff' // White border around degree labels
        },
        formatter: function () {
          if (showYAxisMin) {
            return `${this.value}${unitSymbol}`;  
          } else {
            return this.value === yAxisMin ? '' : `${this.value}${unitSymbol}`;  
          }
        }
      },

      title: { text: null }
    },
    tooltip: { enabled: false },
    legend: {
      padding: 0,
      itemMarginTop: 0,
      itemMarginBottom: 0,
      enabled: true,
      layout: legendLayout,
      align: legendAlign,
      verticalAlign: legendVerticalAlign,
      borderWidth: 0,
      itemStyle: {
        fontSize: '10px',
        color: '#000000',
        fontWeight: 'normal'
      },
      symbolWidth: 16
    },
    credits: { enabled: false },
    series: activeSeries.map((item, index) => {
      const isCurrent = index === totalSeries - 1;
      const ageIndex = totalSeries - 1 - index; // 0 = current, 1 = last year, etc.

      // Configurable gray range (0 = black, 255 = white)
      const startGray = 80; // Closest past year (darker)
      const endGray = 210;   // Oldest past year (lighter)

      let grayColor = '#000000';
      if (!isCurrent) {
        const factor = totalSeries > 2 ? (ageIndex - 1) / (totalSeries - 2) : 0;
        const grayLevel = Math.round(startGray + (endGray - startGray) * factor);
        const hex = grayLevel.toString(16).padStart(2, '0');
        grayColor = `#${hex}${hex}${hex}`;
      }
      

      return {
        name: String(item.name),
        data: convert(item.data),
        lineWidth: isCurrent ? lineWidthCurr : lineWidth,
        dashStyle: 'Solid',
        color: isCurrent ? '#000000' : grayColor,
        zIndex: index
      };
    })
  });
</script>